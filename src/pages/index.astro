---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { existsSync } from 'node:fs';

// Drop a portrait at public/images/aj.jpg and the hero becomes two-column.
// Checked at build time so a missing file means no image tag, not a broken one.
const PHOTO = '/images/aj.jpg';
const hasPhoto = existsSync(new URL(`../../public${PHOTO}`, import.meta.url));

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const lanes = [
  { tag: 'Finance', blurb: 'FP&A, unit economics, audit-grade rigor' },
  { tag: 'Product', blurb: 'Shipped a full-stack SaaS product solo' },
  { tag: 'Data', blurb: 'Python, SQL, Power BI, real datasets' },
  { tag: 'Ops', blurb: 'Led teams, timelines, and hiring' },
  { tag: 'AI', blurb: 'Built with LLMs, and ran research on them' },
];
---

<Base
  title="Andreas Jackson · Analyst, builder, operator"
  description="Analyst and builder: a shipped SaaS product, published empirical research on AI models, and analytics on live business data. EY, Gates Foundation, UC Berkeley Haas."
>
  <section class="section hero">
    <div class:list={['wrap', 'hero-grid', { 'has-photo': hasPhoto }]}>
      {
        hasPhoto && (
          <div class="hero-photo">
            <img
              src={PHOTO}
              alt="Andreas Jackson"
              width="600"
              height="800"
              fetchpriority="high"
            />
          </div>
        )
      }
      <div class="hero-text">
      <h1>Andreas Jackson</h1>
      <p class="role">
        Analyst at EY · Berkeley Haas · San Francisco Bay Area
      </p>
      <p class="lede">
        I've run strategy engagements for the Gates Foundation, IKEA, and
        T-Mobile, shipped a full-stack SaaS product on my own, published an
        empirical study on how AI models behave on real occupational work, and
        I build and advise on the digital side of a short-term rental
        business.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/projects">See my work</a>
        <a class="btn btn-ghost" href="/Andreas_Jackson_Resume.pdf" target="_blank" rel="noopener"
          >Download resume</a
        >
        <a class="btn btn-ghost" href="https://github.com/Andreas-Ja" target="_blank" rel="noopener">GitHub</a>
        <a class="btn btn-ghost" href="https://www.linkedin.com/in/andreas-jackson" target="_blank" rel="noopener"
          >LinkedIn</a
        >
        <a class="btn btn-ghost" href="mailto:andreasjackson@berkeley.edu"
          >Email</a
        >
      </div>
      <p class="cred muted">
        EY &nbsp;·&nbsp; Gates Foundation &nbsp;·&nbsp; IKEA &nbsp;·&nbsp;
        Edison International &nbsp;·&nbsp; UC Berkeley Haas
      </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What I do</p>
      <div class="lane-grid">
        {
          lanes.map((lane) => (
            <a class="lane" href={`/projects?tag=${lane.tag}`}>
              <span class={`tag tag-${lane.tag}`}>{lane.tag}</span>
              <span class="lane-blurb">{lane.blurb}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Featured projects</p>
      <div class="card-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <p style="margin-top: 1.5rem;">
        <a href="/projects">All projects →</a>
      </p>
    </div>
  </section>

  <section class="section why">
    <div class="wrap">
      <p class="eyebrow">Why hire me</p>
      <h2>The case, in four points</h2>
      <div class="why-grid">
        <div class="why-point">
          <span class="why-num">01</span>
          <h3>I've done the work at real stakes</h3>
          <p>
            Bank audits at EY, a partner-selection framework the Gates
            Foundation acted on, and analytics tooling inside a Fortune 500
            utility. <a href="/work">The work history</a> is short but it's
            all load-bearing.
          </p>
        </div>
        <div class="why-point">
          <span class="why-num">02</span>
          <h3>I ship, not just analyze</h3>
          <p>
            A live SaaS product with subscription billing built end to end, a
            published research study, and a booking site I built and maintain.
            <a href="/projects">The projects</a> have receipts rather than
            descriptions.
          </p>
        </div>
        <div class="why-point">
          <span class="why-num">03</span>
          <h3>I'm fast because I use AI well</h3>
          <p>
            I direct AI tools to automate pipelines and build products, which
            makes me quicker than my years of experience suggest.
            <a href="/how-i-work">How I work</a> shows exactly what that
            means in practice.
          </p>
        </div>
        <div class="why-point">
          <span class="why-num">04</span>
          <h3>I show my work</h3>
          <p>
            EY assurance habits: figures trace to sources, estimates are
            labeled as estimates, and metrics the data can't support get left
            out rather than faked. The write-ups include their own limitations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap closer">
      <h2>Hiring for finance, product, data, or ops?</h2>
      <p class="muted" style="max-width: 38rem; margin-block: 0.9rem 1.4rem;">
        I'm looking for a full-time role anywhere in the Bay Area, from San
        Francisco down to the South Bay, plus Santa Barbara or remote. If any
        of the work here looks useful to your team, I'd love to talk.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="mailto:andreasjackson@berkeley.edu"
          >Get in touch</a
        >
        <a class="btn btn-ghost" href="https://www.linkedin.com/in/andreas-jackson" target="_blank" rel="noopener"
          >LinkedIn</a
        >
        <a class="btn btn-ghost" href="https://github.com/Andreas-Ja" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: 5rem 3.5rem;
  }

  .hero h1 {
    max-width: 44rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  /* Portrait: sits above the text on phones, beside it on wider screens. */
  .hero-photo {
    order: -1;
    width: min(11rem, 55vw);
  }

  .hero-photo img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center top;
    border-radius: 18px;
    border: 1px solid var(--line);
    box-shadow: 0 10px 30px rgb(28 32 36 / 0.08);
    background: var(--surface);
  }

  @media (min-width: 780px) {
    .hero-grid.has-photo {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: 3.5rem;
    }

    .hero-photo {
      order: 1;
      width: 100%;
      justify-self: end;
    }
  }

  .role {
    margin-top: 0.7rem;
    font-size: 1.02rem;
    color: var(--ink-faint);
    letter-spacing: 0.005em;
  }

  .lede {
    max-width: 40rem;
    margin-top: 1.1rem;
    font-size: 1.14rem;
    color: var(--ink-soft);
  }

  .cta-row {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 1.7rem;
  }

  .cred {
    margin-top: 2.6rem;
    font-size: 0.9rem;
    letter-spacing: 0.015em;
  }

  .lane-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.9rem;
  }

  .lane {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    padding: 1.05rem 1.15rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 140ms ease;
  }

  .lane:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  .lane-blurb {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .why {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 2rem 2.5rem;
    margin-top: 1.8rem;
  }

  .why-num {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .why-point h3 {
    margin-block: 0.35rem 0.5rem;
  }

  .why-point p {
    font-size: 0.97rem;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: 3rem 2.4rem;
    }
  }
</style>
